# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are safe to expose to the browser; row-level security is what protects
# the data, not the key. Never put the service_role key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
